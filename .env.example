# 复制为 .env 用于本地开发；部署到 Render 时这些变量在 Dashboard 里配置

# Render Postgres 连接串（Blueprint 会自动注入，无需手填）
# 本地开发可指向任意 PostgreSQL，例如：
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xixi_club
DATABASE_URL=

# 访问口令：打开网站后需要输入这个口令才能使用（必填）
ACCESS_CODE=改成你自己的口令

# 会话签名密钥：随便一串长随机字符串（Render Blueprint 会自动生成）
SESSION_SECRET=change-me-to-a-long-random-string

# 端口（本地默认 3000，Render 会自动注入）
PORT=3000
